clear
close all
clc

%% Pre-processor

% Get mesh
load("mesh.mat");

% Plot of Mesh
figure
patch('Faces', t(1:3,:)', ...
      'Vertices', p', ...
      'FaceColor', [0.8 0.9 1.0], ...
      'EdgeColor', [0.2 0.2 0.2]);
axis equal
title('Mesh')

% Compute mesh variables
nelm = length(t);
ndof = length(p);
coord = p';

edof = zeros(nelm, 4);
edof(:,1) = 1:nelm;
edof(:,2:4) = t(1:3, :)';

dof = (1:ndof)';

nen = 3;
[ex, ey] = coordxtr(edof, coord, dof, nen);

% Set material constants

thickness = 1; %m
k = 2; %[W/mK]
qout = 2000; %[W/m²]
alphac = 50; %[W/m²K]
Tinf = 293; %[K]
Q = 4e5; %[W/m³]

D = k*eye(2);
ep = thickness;

% Set up K, f, and bc
K = zeros(ndof);
f = zeros(ndof, 1);

for enr = 1:length(e)
    boundary = e(5, enr);
    node1 = e(1, enr);
    node2 = e(2, enr);

    Le = norm(coord(node1, :) - coord(node2, :));
    
    Kce = zeros(2, 2);
    qn = 0;

    if boundary == 3 %neumann
        qn = -qout; %cooling
    end
    if ismember(boundary, [1 5:20]) %convection
        Kce = alphac*thickness*Le/6*[2 1; 1 2];
        qn = Tinf*alphac;
    end
    fe = qn*thickness*Le/2*[1; 1];
    [K, f] = assem([0 node1 node2], K, Kce, f, fe);
end

%% Solver

for elnr = 1:nelm
    [Ke, fe] = flw2te(ex(elnr,:), ey(elnr,:), ep, D, Q);
    [K, f] = assem(edof(elnr,:), K, Ke, f, fe);
end

%not solveq?
a = solve(K, f);

%% Post-processor

ed = extract(edof, a);

%plot
figure
patch(ex', ey', ed', ed', 'EdgeColor', 'none');

axis equal
colorbar
colormap(jet)

xlim([min(ex(:)) max(ex(:))])
ylim([min(ey(:)) max(ey(:))])

xlabel('x')
ylabel('y')
title('Temperature Field')

set(gca, 'FontSize', 12)
